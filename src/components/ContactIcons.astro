---
import { linkedin, orcid, site } from '../data/site';

interface Props {
	showAddress?: boolean;
}

const { showAddress = false } = Astro.props;
---

<ul class="icon-links">
	<li>
		<a
			class:list={[{ 'with-label': showAddress }]}
			href={`mailto:${site.email}`}
			aria-label={showAddress ? undefined : `Email ${site.name}`}
		>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path
					fill="currentColor"
					d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5L4 8V6l8 5 8-5v2z"
				></path>
			</svg>
			{showAddress ? <span>{site.email}</span> : <span class="sr-only">Email</span>}
		</a>
	</li>
	<li>
		<a href={linkedin} target="_blank" rel="me noopener noreferrer">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path
					fill="currentColor"
					d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.27V1.73C24 .77 23.2 0 22.23 0z"
				></path>
			</svg>
			<span class="sr-only">LinkedIn (opens in a new tab)</span>
		</a>
	</li>
	<li>
		<a href={orcid} target="_blank" rel="me noopener noreferrer">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path
					fill="currentColor"
					d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zM7.37 4.38c.52 0 .95.43.95.95s-.43.94-.95.94a.95.95 0 0 1-.95-.94c0-.52.43-.95.95-.95zM6.42 16.88V7.84h1.9v9.03h-1.9zm4.05 0V7.84h1.9v1.16h.02c.27-.5.91-1.03 1.88-1.03 2 0 2.37 1.32 2.37 3.03v5.88h-1.89v-5.2c0-1.12-.02-2.56-1.56-2.56-1.56 0-1.8 1.22-1.8 2.48v5.28H10.47z"
				></path>
			</svg>
			<span class="sr-only">ORCID (opens in a new tab)</span>
		</a>
	</li>
</ul>
