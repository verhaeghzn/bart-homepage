---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingMinutes, type Post } from '../../lib/posts';
import { topicLabels, type Topic } from '../../data/topics';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			newer: posts[index - 1],
			older: posts[index + 1],
		},
	}));
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingMinutes(post.body);
const minuteLabel = minutes === 1 ? '1 minute' : `${minutes} minutes`;
---

<Base
	title={post.data.title}
	description={post.data.description}
	ogType="article"
	published={post.data.date}
>
	<article>
		<header class="article-head">
			<p class="kicker">Note</p>
			<h1>{post.data.title}</h1>
			<p class="deck">{post.data.description}</p>
			<p class="article-meta">
				<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
				<span>{minuteLabel}</span>
				{
					post.data.topics.map((topic: Topic) => (
						<a href={`/blog/topic/${topic}/`}>{topicLabels[topic]}</a>
					))
				}
			</p>
		</header>
		<div class="prose">
			<Content />
		</div>
		{
			(older || newer) && (
				<nav class="pager" aria-label="More notes">
					{older && (
						<a href={`/blog/${older.id}/`}>
							<span>Older</span>
							<strong>{older.data.title}</strong>
						</a>
					)}
					{newer && (
						<a class="next" href={`/blog/${newer.id}/`}>
							<span>Newer</span>
							<strong>{newer.data.title}</strong>
						</a>
					)}
				</nav>
			)
		}
	</article>
</Base>
